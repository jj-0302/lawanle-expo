{
  "expo": {
    "name": "拉完了",
    "slug": "lawanle-expo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lawanle.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#3FA66D"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.lawanle.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sharing"
    ],
    "scheme": "lawanle",
    "experiments": {
      "typedRoutes": true
    }
  }
}
